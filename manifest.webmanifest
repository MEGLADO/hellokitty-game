{
  "name": "Hello Kitty Dream Dash",
  "short_name": "Kitty Dash",
  "description": "A fan-made 3D Hello Kitty endless runner for phones.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "fullscreen",
  "orientation": "portrait",
